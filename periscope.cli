#!/bin/bash
# periscope CLI — installed to /usr/local/bin/periscope by setup.sh
DIR="__DIR__"
PY="$DIR/venv/bin/python"
CMD="$1"; shift

svc() { exec "$PY" -m periscope.cli "$DIR" "$CMD" "$@"; }

case "$CMD" in
    list|status|enable|disable|check|config|presence|bots|web|reload|init) svc "$@" ;;
    layout)  exec "$PY" "$DIR/scripts/git_layout.py" "$@" ;;
    update)  exec bash "$DIR/update.sh" ;;
    logs)    if [ -n "$1" ]; then exec journalctl -u periscope -f -o cat | grep --line-buffered -i -E "\[$1\]|periscope_$1|$1"; else exec journalctl -u periscope -f; fi ;;
    restart) systemctl restart periscope && echo "periscope restarted." ;;
    start)   systemctl start periscope && echo "periscope started." ;;
    stop)    systemctl stop periscope && echo "periscope stopped." ;;
    *)
        "$PY" - <<'PY'
from periscope.banner import BANNER, __version__
print(BANNER)
print(f"  periscope v{__version__} — one service, every integration, a web UI")
PY
        cat <<USAGE

  usage: periscope <command> [args]

    web                     the admin UI address + a one-time sign-in link (configure everything there)
    list                    every service: state · bot it posts as · what needs attention
    enable <svc...>         turn a service on (config must be complete; restart applies)
    disable <svc...>
    check <svc>             test a service's credentials right now
    config <svc>            show a service's settings, secrets masked
    bots [add|token|use]    the Discord bot identities services post as (alias: presence)
    init                    first-run: paste a bot token, pick the server, create channels — or use the web UI
    layout                  apply the #git-* / #op-* channel convention (see --help)
    reload                  apply the config to the running process now (settings apply by themselves anyway)
    status                  raw runtime status (bots, services, errors) as JSON
    logs [svc]              follow the runtime log, optionally one service
    restart | start | stop  the periscope service
    update                  git pull, reinstall, restart

USAGE
        ;;
esac
