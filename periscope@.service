[Unit]
Description=periscope — %i bot for Discord
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__DIR__/bots/%i
EnvironmentFile=__DIR__/bots/%i/.env
ExecStart=__DIR__/venv/bin/python -m periscope_%i
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
