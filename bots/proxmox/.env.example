# ---------- Discord (shared by every lab bot) ----------
# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Name of your lab; shown in every embed footer so several members' bots can share a channel
LAB_NAME=my-lab
# Optional hex accent color for your lab (no #)
LAB_COLOR=5865F2
# Your Discord server id (enable Developer Mode, right-click server -> Copy Server ID). Set it: commands sync instantly.
GUILD_ID=
# Channel where alerts (node down, high CPU, storage full, backup failed) are posted
ALERT_CHANNEL_ID=
# Channel where the live pinned status board lives (can be the same channel)
STATUS_CHANNEL_ID=
# Optional role id pinged on CRITICAL alerts
ALERT_ROLE_ID=
# Comma-separated role ids allowed to start/stop/reboot guests. Unset = server administrators only.
ADMIN_ROLE_IDS=
# How often (seconds) the status board refreshes and thresholds are checked
STATUS_INTERVAL_S=60
# Persistent state directory (state.json: board message id, open alerts, last-seen guest states)
DATA_DIR=data
# Port for the internal /health endpoint used by the Docker HEALTHCHECK
WEBHOOK_PORT=8080
# INFO or DEBUG
LOG_LEVEL=INFO

# ---------- Proxmox VE ----------
# API base URL of any cluster node, including port
PVE_URL=https://pve.example.lan:8006
# API token id in the form user@realm!tokenname (see README for how to create it)
PVE_TOKEN_ID=periscope@pve!discord
# The secret shown once when the token was created
PVE_TOKEN_SECRET=
# Verify the PVE TLS certificate. Leave false for the default self-signed cert.
PVE_VERIFY_SSL=false
# Node CPU % that triggers a WARNING after 3 consecutive polls above it
PVE_CPU_WARN=85
# Node memory % that triggers a WARNING
PVE_MEM_WARN=90
# Storage usage % for WARNING / CRITICAL
PVE_STORAGE_WARN=85
PVE_STORAGE_CRIT=95
# Watch vzdump backup tasks every 5 minutes and post a summary / failure alert
PVE_WATCH_BACKUPS=true
