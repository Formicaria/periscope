# ---- Discord (shared by every lab bot; see periscope/core) ----
DISCORD_TOKEN=                 # bot token from the Discord developer portal (secret)
LAB_NAME=lab                   # shown in every embed footer; one bot instance per lab
LAB_COLOR=5865F2               # hex accent colour (no #)
GUILD_ID=                      # your server id -> slash commands sync instantly to this guild
ALERT_CHANNEL_ID=              # channel that receives firing/resolved alerts
STATUS_CHANNEL_ID=             # channel that holds the pinned live status board
ALERT_ROLE_ID=                 # optional role pinged on CRITICAL alerts
ADMIN_ROLE_IDS=                # comma-separated role ids allowed to silence/unsilence (empty = server admins)
DATA_DIR=data                 # persistent state (alert message ids, board message id)
LOG_LEVEL=INFO
STATUS_INTERVAL_S=60           # status board refresh + scrape-target watch interval (seconds)

# ---- Inbound webhook server (Alertmanager -> bot) ----
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8081
WEBHOOK_SECRET=                # shared secret; Alertmanager must send ?token=<secret> (secret)

# ---- Prometheus ----
PROM_URL=http://prometheus:9090        # base URL of the Prometheus server
PROM_BASIC_USER=                       # optional HTTP basic auth (applies to Prometheus + Alertmanager)
PROM_BASIC_PASS=                       # (secret)
PROM_TARGET_WATCH=true                 # fire a WARNING alert when a scrape target goes down
VERIFY_SSL=true                        # set false for self-signed certificates

# ---- Alertmanager ----
ALERTMANAGER_URL=http://alertmanager:9093

# ---- Grafana (optional; leave GRAFANA_URL blank to disable /prom dashboards + /prom panel) ----
GRAFANA_URL=http://grafana:3000
GRAFANA_TOKEN=                         # service account token with Viewer role (secret)
GRAFANA_ORG_ID=1
GRAFANA_RENDER_WIDTH=1000              # panel PNG size (needs grafana-image-renderer plugin)
GRAFANA_RENDER_HEIGHT=500
GRAFANA_DEFAULT_DASHBOARD_UID=         # optional; linked from the status board
