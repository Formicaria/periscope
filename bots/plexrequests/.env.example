# ---- Discord (shared by every periscope bot) ----
DISCORD_TOKEN=  # Bot token: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
LAB_NAME=my-lab  # Name of your lab (periscope-wide branding)
GUILD_ID=  # The lab's Discord server id (used when PLEXREQ_GUILD_ID is empty)
DATA_DIR=data  # Persistent state directory
LOG_LEVEL=INFO  # INFO or DEBUG

# ---- Plex server (Discord side) ----
PLEXREQ_GUILD_ID=  # Discord server the invite/request channels live in (empty = GUILD_ID). May differ from the lab server.
CHANNEL_ID=  # Invite channel id (#join-plex): Get Plex Access button, typed emails, /plexinvite
CHANNEL_NAME=join-plex  # Invite channel name, used in messages and as a fallback when CHANNEL_ID is empty
REQUESTS_CHANNEL_ID=  # Requests channel id: Search & Request button, typed titles; empty = requests off

# ---- Plex ----
PLEX_URL=http://YOUR_PLEX_IP:32400  # Plex server URL, e.g. http://192.168.1.10:32400
PLEX_TOKEN=  # Plex account token of the server owner. Empty? Run scripts/plex_token.py (plex.tv/link flow)
LIBRARIES=all  # Libraries shared with invitees: all, or comma-separated library names
PLEX_LINK=  # Shown on green "available" cards, e.g. plex.yourdomain.com (empty = "Plex")
SERVER_NAME=  # Branding in embeds and command text, e.g. yourdomain.com (empty = plain "Plex")

# ---- Requests backend ----
REQUEST_BACKEND=auto  # auto | seerr | arr. auto = Seerr when configured, else native Radarr/Sonarr
OVERSEERR_URL=  # Overseerr / Jellyseerr base URL, e.g. http://192.168.1.11:5055
OVERSEERR_API_KEY=  # Seerr API key (Settings -> General)

# ---- Radarr / Sonarr (native backend) ----
RADARR_URL=  # Radarr base URL, e.g. http://192.168.1.12:7878
RADARR_API_KEY=  # Radarr API key (Settings -> General -> Security)
RADARR_PROFILE=  # Quality profile name to add movies with (empty = first profile)
RADARR_ROOT=  # Root folder path for movies (empty = first root folder)
SONARR_URL=  # Sonarr base URL, e.g. http://192.168.1.13:8989
SONARR_API_KEY=  # Sonarr API key (Settings -> General -> Security)
SONARR_PROFILE=  # Quality profile name to add series with (empty = first profile)
SONARR_ROOT=  # Root folder path for series (empty = first root folder)
FALLBACK_BEFORE_YEAR=2016  # Titles released before this year use the fallback profile (old titles rarely exist in 4K). 0 = off
RADARR_FALLBACK_PROFILE=  # Fallback profile name (empty = auto: your 1080p profile, only when the main one is 4K-only)
SONARR_FALLBACK_PROFILE=  # Fallback profile name (empty = auto, as above)

# ---- Channels (name or id; empty = feature off) ----
STATUS_CHANNEL=  # Live status board: streams, Radarr/Sonarr queues, disk space
NEW_CHANNEL=  # New-on-Plex feed (baselines silently on first run)
MOVIES_CHANNEL=  # Where movie announcement cards go (empty = the requests channel)
TV_CHANNEL=  # Where TV announcement cards go (empty = the requests channel)

# ---- Behaviour ----
ROLE_NAME=plex members  # Role granted after a successful invite (created if missing)
REQUESTS_ROLE_NAME=plex members  # Role required to request media (empty = anyone; server admins always may)
AUTO_REVOKE=0  # 1 = revoke the Plex share when a member leaves or loses ROLE_NAME (needs Server Members Intent)
