# ---- Discord (shared by every lab bot) ----------------------------------------
# Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=
# Name shown in every embed footer; tells labs apart when several bots share a channel
LAB_NAME=my-lab
# Hex embed accent color (no #)
LAB_COLOR=5865F2
# Your Discord server id (Developer Mode → right-click server → Copy ID). Set it: commands sync instantly.
GUILD_ID=
# Channel for alerts (container exited, unhealthy, restart loop, ...)
ALERT_CHANNEL_ID=
# Channel that holds the pinned, self-updating status board
STATUS_CHANNEL_ID=
# Role to ping on CRITICAL alerts (optional)
ALERT_ROLE_ID=
# Comma-separated role ids allowed to start/stop/restart containers.
# Empty = anyone with the Administrator permission on the server.
ADMIN_ROLE_IDS=
# How often (seconds) to refresh the status board
STATUS_INTERVAL_S=60
# Persistent state directory (mounted volume in Docker)
DATA_DIR=data
# Port for the /health endpoint used by the Docker HEALTHCHECK (no webhooks are received)
WEBHOOK_PORT=8085
LOG_LEVEL=INFO

# ---- Docker daemon -------------------------------------------------------------
# Where the Engine API lives: a unix socket path (the default), or tcp://host:2375,
# or https://host:2376 for a daemon behind TLS. A socket proxy works here too.
DOCKER_HOST=/var/run/docker.sock
# Verify the TLS certificate of whatever this connects to — the daemon, or Portainer when you use that.
# Off by default because lab appliances almost always present a self-signed one. true also turns a
# tcp:// endpoint into https://
DOCKER_TLS_VERIFY=false
# CA certificate that signed the daemon's certificate (PEM file)
DOCKER_CA_PATH=
# Client certificate (PEM file). A directory works too: ca.pem / cert.pem / key.pem are read from it,
# the way the docker CLI reads DOCKER_CERT_PATH
DOCKER_CERT_PATH=
# Client private key (PEM file)
DOCKER_KEY_PATH=

# ---- Portainer (instead of the socket) -----------------------------------------
# Fill these in to reach Docker through Portainer rather than the daemon itself, e.g.
# https://portainer.lan:9443 — every call goes through /api/endpoints/<id>/docker/...
PORTAINER_URL=
# Access token: Portainer → My account → Access tokens → Add access token
PORTAINER_API_KEY=
# Which environment (endpoint) in Portainer; the first local one is almost always 1
PORTAINER_ENDPOINT_ID=1

# ---- What to watch -------------------------------------------------------------
# Comma-separated name globs to watch, e.g. jellyfin,*arr,traefik. Empty = every container.
DOCKER_INCLUDE=
# Comma-separated name globs to leave out, applied after DOCKER_INCLUDE, e.g. buildx_*,*-test
DOCKER_IGNORE=
# How often (seconds) to poll the daemon for container state
DOCKER_POLL_S=60
# WARNING alert when a container restarts this many times within an hour
DOCKER_RESTART_LOOP_N=3
# Alert when a container stops cleanly too. Off by default: a container you stopped
# yourself is not a problem, but a non-zero exit code always alerts.
DOCKER_ALERT_ON_STOP=false
# Ask the registry whether the images in use have a newer digest
DOCKER_CHECK_UPDATES=false
# How often (hours) to run that update check
DOCKER_UPDATE_CHECK_H=12
