# ---- Discord (shared by every lab bot) ----------------------------------------
# Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=
# Name shown in every embed footer; tells labs apart when several bots share a channel
LAB_NAME=my-lab
# Hex embed accent color (no #)
LAB_COLOR=5865F2
# Your Discord server id (Developer Mode → right-click server → Copy ID). Set it: commands sync instantly.
GUILD_ID=
# Channel for alerts (device offline, WAN down, new clients, ...)
ALERT_CHANNEL_ID=
# Channel that holds the pinned, self-updating status board
STATUS_CHANNEL_ID=
# Role to ping on CRITICAL alerts (optional)
ALERT_ROLE_ID=
# Comma-separated role ids allowed to kick/block clients and restart devices.
# Empty = anyone with the Administrator permission on the server.
ADMIN_ROLE_IDS=
# How often (seconds) to poll the controller and refresh the status board
STATUS_INTERVAL_S=60
# Persistent state directory (mounted volume in Docker)
DATA_DIR=data
# Port for the /health endpoint used by the Docker HEALTHCHECK (no webhooks are received)
WEBHOOK_PORT=8083
LOG_LEVEL=INFO

# ---- UniFi ---------------------------------------------------------------------
# UniFi OS console (UDM / UDM Pro / UDR / UCG / Cloud Key Gen2+): https://192.168.1.1
# Self-hosted Network Application:                                https://unifi.lan:8443
UNIFI_URL=https://192.168.1.1
# LOCAL admin (not a Ubiquiti SSO account). Read-only is enough for monitoring; see README.
UNIFI_USER=
UNIFI_PASS=
# Site name as it appears in the URL (…/network/site/<name>/…). Almost always "default".
UNIFI_SITE=default
# true  → UniFi OS console (login /api/auth/login, API under /proxy/network)
# false → self-hosted controller (login /api/login, API at the root)
UNIFI_IS_UNIFI_OS=true
# Controllers almost always use a self-signed cert; keep false unless you installed a real one
VERIFY_SSL=false
# Post an INFO embed when a never-seen (or long-unseen) client joins
UNIFI_ALERT_NEW_CLIENTS=true
# WARNING alert when WAN latency exceeds this for 3 consecutive polls
UNIFI_WAN_LATENCY_WARN_MS=100
# WARNING alert when a device's CPU exceeds this % for 3 consecutive polls
UNIFI_DEVICE_CPU_WARN=80
# A client not seen for this many days counts as "new" again when it reappears
UNIFI_KNOWN_CLIENTS_TTL_DAYS=30
