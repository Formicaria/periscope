# ---------- Discord (periscope core) ----------
DISCORD_TOKEN=                 # Bot token from the Discord developer portal (required)
LAB_NAME=lab                   # Shown in every embed footer; one bot instance per lab
LAB_COLOR=5865F2               # Hex color used for INFO embeds
GUILD_ID=                      # Your server id → slash commands sync instantly (else global, up to 1h)
ALERT_CHANNEL_ID=              # Where alerts (health issues, stalled downloads, unreachable services) go
STATUS_CHANNEL_ID=             # Where the live "Media stack" board is pinned and edited in place
ALERT_ROLE_ID=                 # Role pinged on CRITICAL alerts (optional)
ADMIN_ROLE_IDS=                # Comma-separated role ids allowed to run /arr remove (default: server admins)
DATA_DIR=data                 # Persistent state (alert + board message ids)
LOG_LEVEL=INFO
STATUS_INTERVAL_S=60           # How often the status board is refreshed

# ---------- Webhook server (always on for this bot) ----------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8082
WEBHOOK_SECRET=                # Shared secret; *arr webhook URLs must include ?token=<this>

# ---------- *arr apps (a service is enabled when its URL is set) ----------
SONARR_URL=                    # e.g. http://sonarr:8989
SONARR_API_KEY=                # Settings → General → Security → API Key
RADARR_URL=                    # e.g. http://radarr:7878
RADARR_API_KEY=
LIDARR_URL=                    # e.g. http://lidarr:8686
LIDARR_API_KEY=
PROWLARR_URL=                  # e.g. http://prowlarr:9696
PROWLARR_API_KEY=

# ---------- Download clients ----------
QBIT_URL=                      # e.g. http://qbittorrent:8080 (Web UI must be enabled)
QBIT_USER=                     # Web UI username (blank if auth is bypassed for this host)
QBIT_PASS=                     # Web UI password
SABNZBD_URL=                   # e.g. http://sabnzbd:8080
SABNZBD_API_KEY=               # Config → General → API Key

# ---------- Media servers ----------
PLEX_URL=                      # e.g. http://plex:32400
PLEX_TOKEN=                    # X-Plex-Token (see README for how to find it)
JELLYFIN_URL=                  # e.g. http://jellyfin:8096
JELLYFIN_API_KEY=              # Dashboard → API Keys

# ---------- Behaviour ----------
VERIFY_SSL=true                # false to accept self-signed certificates
MEDIA_CHANNEL_ID=              # Where Grab/Import/Upgrade/... webhook events are posted (default: ALERT_CHANNEL_ID)
ARR_QUEUE_STALL_MIN=30         # Alert when a downloading queue item hasn't progressed for this many minutes
