# ---- Discord (periscope core) ----
DISCORD_TOKEN=                 # Bot token from https://discord.com/developers/applications
LAB_NAME=THE LAB               # Shown in every embed footer; one bot instance per lab
LAB_COLOR=5865F2               # Hex color (no #) used for neutral embeds
GUILD_ID=                      # Your Discord server id (instant slash-command sync)
ALERT_CHANNEL_ID=              # Channel for CI-failure / API-unreachable alerts (also default feed if GITHUB_FEED_CHANNEL_ID unset)
STATUS_CHANNEL_ID=             # Channel for the live /gh watch org overview board
ALERT_ROLE_ID=                 # Role pinged on CRITICAL alerts (optional)
ADMIN_ROLE_IDS=                # Comma list of role ids treated as bot admins (optional)
STATUS_INTERVAL_S=60           # How often the status board is re-rendered
DATA_DIR=data                 # Persistent state (JSON) lives here
LOG_LEVEL=INFO

# ---- Webhook server (primary event source) ----
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8084
WEBHOOK_SECRET=                # REQUIRED for GitHub: same value you enter as the webhook "Secret" on GitHub (HMAC X-Hub-Signature-256)

# ---- GitHub ----
GITHUB_ORG=formicaria          # Organization login
GITHUB_TOKEN=                  # Fine-grained PAT (read-only) for /gh commands and polling; see README for permissions
GITHUB_FEED_CHANNEL_ID=        # Default channel for the activity feed (falls back to ALERT_CHANNEL_ID)
GITHUB_REPO_CHANNEL_MAP=       # Route repos to channels: anthill=123,sovrgn=456,op-*=789 (glob * supported)
GITHUB_EVENTS=                 # Comma list of X-GitHub-Event names to post (empty = all). e.g. push,pull_request,release,workflow_run
GITHUB_IGNORE_BOTS=true        # Skip events whose sender login ends with [bot] (dependabot, github-actions, ...)
GITHUB_CI_FAILURE_ROLE_ID=     # Role to ping when a workflow fails on a repo's default branch (optional)

# ---- Polling fallback (only if you cannot create an org webhook) ----
GITHUB_POLL_ENABLED=false
GITHUB_POLL_INTERVAL_S=120
