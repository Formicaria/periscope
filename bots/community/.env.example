# ---------- Community ----------
# Channel for public service announcements: outages (and why), scheduled maintenance, anything an admin posts with /psa post
PSA_CHANNEL_ID=
# Fallback role pinged by an outage or maintenance when the resource names no roles of its own (blank = nobody)
PSA_ROLE_ID=
# Who announcements and changelogs (/psa post, the outbox) ping: everyone, here, role names/ids, or none
ANNOUNCE_PING=everyone
# What the community uses, separated by ";" — each one is: Name | check | target | proxmox guest | depends on | roles to ping
#   check: plex (GET /identity), http (any answer below 500), tcp (port open), minecraft (port open + player count), guest (only the Proxmox guest's state)
#   guest: ct:139 or vm:137 — lets periscope say WHY something is down (host offline, container stopped, app not answering)
#   depends on: names of other resources, comma separated — "Plex is down because its media storage is"
#   roles to ping: role names or ids, comma separated — who gets pinged when it goes down or has maintenance
RESOURCES=
# How long a resource has to stay down before the outage post goes out (seconds) — rides out restarts and blips
OUTAGE_GRACE_S=180
# The time zone admins type maintenance times in (an IANA name like America/Phoenix)
TIMEZONE=America/Phoenix
# Borrow Proxmox API access from this periscope service to explain outages (blank = no diagnosis, just "down")
PVE_FROM_SERVICE=proxmox
# Keep a live status board of every resource pinned in the PSA channel
COMMUNITY_BOARD=true
# Folder periscope watches for announcements to post: drop a .md file in (first "# " line is the title) and it goes out
PSA_OUTBOX=data/psa-outbox
# ---------- Linking (/link) ----------
# Minecraft servers whose in-game chat is relayed into Discord, separated by ";" — each: Resource name | chat channel id | roles to give
#   (roles default to that resource's ping roles in RESOURCES). /link minecraft hands out a code; typing it in game proves who's who.
LINK_MINECRAFT=
# The role someone gets once /link plex has checked (on plex.tv) that their Plex account has this server (blank = /link plex off)
LINK_PLEX_ROLE=
# Borrow PLEX_URL / PLEX_TOKEN from this periscope service to check Plex accounts against the share list
PLEX_FROM_SERVICE=plexrequests
